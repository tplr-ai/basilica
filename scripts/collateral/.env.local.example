# Copy this file to .env.local and fill in real values.
# Example:
#   cp scripts/collateral/.env.local.example scripts/collateral/.env.local

# Network and contract selection
NETWORK=local
CONTRACT_ADDRESS=<required>

# Signing key (hex, usually with 0x prefix)
PRIVATE_KEY=<required>

# Node collateral identifiers
HOTKEY=<required>
NODE_ID=<required>
ALPHA_HOTKEY=<required>
ALPHA_AMOUNT_WEI=1000000000000000000

# Evidence metadata used by reclaim/deny
URL=https://example.com/evidence
URL_CONTENT_SHA256=<required_64_hex_chars>

# Optional explicit reclaim request ID for finalize/deny commands.
# Set this from a ReclaimProcessStarted event scan.
RECLAIM_REQUEST_ID=

# Optional events output format for manual event scans (pretty|json)
EVENTS_FORMAT=pretty
